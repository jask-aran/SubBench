{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "subbench",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-15",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subbench",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],

  "assets": {
    "directory": "src/subbench/server/static",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Prune usage rows once a window is long settled. Entitlement snapshots are never
  // pruned: they are small, and an unsampled moment cannot be recovered.
  "triggers": { "crons": ["0 4 * * *"] },

  "vars": { "USAGE_RETENTION_DAYS": "90" },

  "observability": { "enabled": true }
}
