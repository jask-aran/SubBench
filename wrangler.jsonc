{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "subbench",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-15",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subbench",
      "database_id": "0f4f6728-405c-4594-b627-7a9a2e3875e7"
    }
  ],

  // Routing lives here rather than in the dashboard so the deployed surface is described
  // by the repository. Cloudflare creates the DNS record for a custom domain itself.
  "routes": [
    { "pattern": "subbench.jask-aran.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "src/subbench/server/static",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Prune usage rows once a window is long settled. Entitlement snapshots are never
  // pruned: they are small, and an unsampled moment cannot be recovered.
  "triggers": { "crons": ["0 4 * * *"] },

  "vars": { "USAGE_RETENTION_DAYS": "90" },

  "observability": { "enabled": true }
}
