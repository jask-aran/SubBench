# Written by `subbench service install`, which is the way to install this; kept here for
# reference and for machines that manage units by hand. Replace ExecStart with the path
# of the subbench executable.
[Unit]
Description=SubBench subscription usage collector
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/subbench/push.env
ExecStart=%h/.local/bin/subbench watch --provider all
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
